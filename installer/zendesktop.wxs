<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ZenDesktop Installer -->
  <Package
    Name="ZenDesktop"
    Manufacturer="ZenDesktop"
    Version="$(var.Version)"
    UpgradeCode="7E8F4A2D-1B3C-4D5E-8F9A-0B1C2D3E4F5A"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ZenDesktop is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for Add/Remove Programs -->
    <Icon Id="zendesktop.ico" SourceFile="$(var.SrcDir)\zendesktop.ico" />

    <Property Id="ARPPRODUCTICON" Value="zendesktop.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jaimitus/ZenDesktop" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jaimitus/ZenDesktop" />
    <Property Id="ARPCOMMENTS" Value="Ultra-lightweight native desktop organizer for Windows" />

    <!-- Install to Program Files\ZenDesktop -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ZenDesktop">
        <!-- Main executable component -->
        <Component Id="MainExe" Guid="A1B2C3D4-0001-4E5F-8A9B-0C1D2E3F4A5B">
          <File Id="ZenDesktopExe"
                Source="$(var.SrcDir)\ZenDesktop.exe"
                KeyPath="yes"
                Checksum="yes" />
        </Component>

        <Component Id="AppIcon" Guid="A1B2C3D4-0002-4E5F-8A9B-0C1D2E3F4A5B">
          <File Id="ZenDesktopIco"
                Source="$(var.SrcDir)\zendesktop.ico" />
        </Component>

        <!-- LICENSE and README -->
        <Component Id="Docs" Guid="A1B2C3D4-0003-4E5F-8A9B-0C1D2E3F4A5B">
          <File Id="LicenseFile" Source="$(var.SrcDir)\LICENSE" />
          <File Id="ReadmeFile" Source="$(var.SrcDir)\README.md" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="A1B2C3D4-0004-4E5F-8A9B-0C1D2E3F4A5B">
        <Shortcut Id="ZenDesktopShortcut"
                  Name="ZenDesktop"
                  Description="Ultra-lightweight desktop organizer"
                  Target="[INSTALLFOLDER]ZenDesktop.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="zendesktop.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\ZenDesktop"
                       Name="installed"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Desktop shortcut (optional, off by default) -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="A1B2C3D4-0005-4E5F-8A9B-0C1D2E3F4A5B" Condition="INSTALLDESKTOPSHORTCUT">
        <Shortcut Id="DesktopZenShortcut"
                  Name="ZenDesktop"
                  Description="Ultra-lightweight desktop organizer"
                  Target="[INSTALLFOLDER]ZenDesktop.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="zendesktop.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\ZenDesktop"
                       Name="desktopShortcut"
                       Value="1"
                       Type="integer"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Complete" Title="ZenDesktop" Level="1" Display="expand"
             Description="Ultra-lightweight native desktop organizer for Windows"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="Docs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>

</Wix>
