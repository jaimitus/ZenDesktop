// ============================================================================
//  ZenDesktop :: zendesktop.rc
//  Recursos de Windows compilados por build.rs (embed-resource).
//  Las rutas de los iconos son relativas a este archivo.
//
//    Recurso 1  -> icono de la aplicacion (Explorer, barra de tareas).
//    Recurso 2  -> icono de la bandeja del sistema (variante transparente).
//    Recurso 1  -> version info (propiedades del .exe).
// ============================================================================

1 ICON "icons/zendesktop.ico"
2 ICON "icons/zendesktop-tray.ico"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS         0x40004L          // VOS_NT_WINDOWS32
FILETYPE       0x1L              // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"        // en-US, Unicode
        BEGIN
            VALUE "CompanyName",      "ZenDesktop Core Team"
            VALUE "FileDescription",  "Organizador dinamico de escritorio"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "zendesktop"
            VALUE "LegalCopyright",   "MIT"
            VALUE "OriginalFilename", "zendesktop.exe"
            VALUE "ProductName",      "ZenDesktop"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
